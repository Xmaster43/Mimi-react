# ===========================================
# PRODUCTION - AWS Amplify (API Gateway + Lambda)
# ===========================================
# Single base URL - API Gateway handles routing via /api/{service}/{proxy+}
# VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod

# ===========================================
# LOCAL DEVELOPMENT - Individual Microservices
# ===========================================
# No API Gateway locally - direct to each service
VITE_API_AUTH=http://localhost:8081/api/auth
VITE_API_USERS=http://localhost:8084/api/users
VITE_API_PRODUCTS=http://localhost:8087/api
VITE_API_SERVICES=http://localhost:8083/api
VITE_API_WORKERS=http://localhost:8082/api
VITE_API_RESERVATIONS=http://localhost:8086/api